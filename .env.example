# Public production URL (enables canonical links, og:url, sitemap.xml). No trailing slash.
VITE_SITE_URL=

# Endpoint that accepts a JSON POST from the contact form. Use /api/contact for the built-in
# Vercel function (api/contact.js) that saves enquiries to Google Sheets.
# Leave empty until configured — the form will then clearly report that online enquiries are not connected.
VITE_CONTACT_ENDPOINT=

# Server-only (no VITE_ prefix, never sent to the browser) — used by api/contact.js.
# Apps Script web app URL (ends in /exec) and the shared secret set in scripts/google-sheets-contact.gs.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=

# Public contact address shown for "Say hello" and as a fallback when the form endpoint is not configured.
VITE_CONTACT_EMAIL=

# Admin panel at /admin (server-only). One admin login; the session secret signs the login cookie.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
